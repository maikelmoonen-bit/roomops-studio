<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- CA1848/CA1873: LoggerMessage source generation is not required for this application's log volume.
         CA1515: types are public because the bridge contract generator reflects over them.
         CA1062: nullable reference types are enabled and enforced. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1515;CA1062;CA1716;CA1711;CA1720;CA1724;CA1034;CA1054;CA1056;CA1002;CA2227;CA1819;CA1307;CA1309;CA1305;CA1304;CA1311;CA1031;CA1032;CA1064;CA1812;CA1852;CA2007;CA1822;CA1859;CA1860;CA1861;CA1863;CA1865;CA1866;CA1867;CA1869;CA1870;CA2201;CA1303;CA5394;CA1308;CA1847;CA1806;CA2016;CA1826</NoWarn>
    <Company>RoomOps Studio</Company>
    <Product>RoomOps Studio</Product>
    <Version>1.4.0</Version>
    <InformationalVersion>1.4.0</InformationalVersion>
    <Copyright>RoomOps Studio</Copyright>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
