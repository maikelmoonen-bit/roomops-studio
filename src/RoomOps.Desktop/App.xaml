<Application x:Class="RoomOps.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Graphite" Color="#121418" />
    <SolidColorBrush x:Key="Panel" Color="#1B1F25" />
    <SolidColorBrush x:Key="Line" Color="#2A2F37" />
    <SolidColorBrush x:Key="Ink" Color="#E8EAEE" />
    <SolidColorBrush x:Key="InkMuted" Color="#8A919D" />
    <SolidColorBrush x:Key="Accent" Color="#36B5F2" />
  </Application.Resources>
</Application>
