<?xml version="1.0" encoding="utf-8"?>
<!--
  RoomOps Studio: per-machine Windows Installer package (x64), built by build.sh with wixl (msitools).
  The file list (ProductFiles) is generated from the publish folder at build time with wixl-heat.
  Never change the UpgradeCode: it is how a newer version finds and replaces an installed one.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="RoomOps Studio" Language="1033" Version="$(var.Version)" Manufacturer="RoomOps Studio"
           UpgradeCode="FE7F374B-FFB9-4528-B909-F2552E534D90">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="RoomOps Studio $(var.Version)" Manufacturer="RoomOps Studio"
             Comments="Intelligent Workspace Administration for Microsoft 365 meeting rooms" />

    <!-- Same-version upgrades let a rebuilt package replace the installed one instead of installing a second copy. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of RoomOps Studio is already installed." />
    <Media Id="1" Cabinet="RoomOpsStudio.cab" EmbedCab="yes" />

    <Icon Id="RoomOpsStudio.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="RoomOpsStudio.ico" />
    <Property Id="ARPCOMMENTS" Value="Intelligent Workspace Administration for Microsoft 365 meeting rooms" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="RoomOps Studio" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <!-- A shortcut needs a registry key path. HKLM, not HKMU: wixl 0.103 writes HKMU as an invalid root. -->
    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="F8221EEF-A451-47AA-8D78-7761A63F383D" Win64="yes">
        <Shortcut Id="RoomOpsStudioShortcut" Name="RoomOps Studio" Description="Microsoft 365 meeting room administration"
                  Target="[INSTALLDIR]RoomOpsStudio.exe" WorkingDirectory="INSTALLDIR" Icon="RoomOpsStudio.ico" />
        <RegistryValue Root="HKLM" Key="Software\RoomOps Studio" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Complete" Title="RoomOps Studio" Level="1">
      <ComponentGroupRef Id="ProductFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
